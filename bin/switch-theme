#!/usr/bin/env bash
set -euo pipefail

mode="$(gsettings get org.gnome.desktop.interface color-scheme | tr -d "'")"

ZELLIJ_CFG="$HOME/.config/zellij/config.kdl"

if [[ "$mode" == "prefer-dark" ]]; then
  theme="github-dark"
else
  theme="github-light"
fi

# Zellij: set the (non-commented) theme line; themes live in ~/.config/zellij/themes/github.kdl.
# Only rewrite when it changes, since Zellij live-reloads on every write.
if ! grep -qE "^[[:space:]]*theme[[:space:]]+\"$theme\"" "$ZELLIJ_CFG"; then
  sed -i -E "s/^([[:space:]]*theme[[:space:]]+)\"[^\"]*\"/\1\"$theme\"/" "$ZELLIJ_CFG"
fi
