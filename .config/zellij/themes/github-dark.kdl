            emphasis_0 240 136 62
            emphasis_1 121 192 255
            emphasis_2 219 97 162
            emphasis_3 0
        }
        frame_highlight {
            base 240 136 62
            background 0
            emphasis_0 240 136 62
            emphasis_1 240 136 62
            emphasis_2 240 136 62
            emphasis_3 240 136 62
        }
        exit_code_success {
            base 86 211 100
            background 0
