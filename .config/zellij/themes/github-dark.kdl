            emphasis_1 240 136 62
            emphasis_2 219 97 162
            emphasis_3 108 164 248
        }
        ribbon_unselected {
            base 22 27 34
            background 139 148 158
            emphasis_0 247 129 102
            emphasis_1 201 209 217
            emphasis_2 108 164 248
            emphasis_3 219 97 162
        }
        table_title {
            base 86 211 100
