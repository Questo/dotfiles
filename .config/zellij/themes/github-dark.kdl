            emphasis_0 240 136 62
            emphasis_1 121 192 255
            emphasis_2 86 211 100
            emphasis_3 219 97 162
        }
        table_cell_selected {
            base 201 209 217
            background 48 54 61
            emphasis_0 240 136 62
            emphasis_1 121 192 255
            emphasis_2 86 211 100
            emphasis_3 219 97 162
        }
        table_cell_unselected {
            base 201 209 217
