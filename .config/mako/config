# Catppuccin Mocha-ish, matches waybar
font=FiraCode Nerd Font Propo 12
background-color=#1e1e2ef0
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
border-radius=10
padding=12
margin=10
width=360
max-icon-size=48
anchor=top-right
default-timeout=5000
max-visible=5
layer=overlay
progress-color=over #45475a

[urgency=low]
border-color=#45475a

[urgency=critical]
border-color=#f38ba8
default-timeout=0

[mode=do-not-disturb]
invisible=1

[app-name=OSD]
anchor=top-center
width=260
border-color=#fab387
format=<b>%s</b>  %b

[app-name=Screenshot]
max-icon-size=96
border-color=#f5c2e7
